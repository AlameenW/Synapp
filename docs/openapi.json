{
  "openapi": "3.1.0",
  "info": {
    "title": "Synapp API",
    "version": "0.2.0",
    "description": "Class-project educational backend. Content is editorial draft. AI integration is deferred."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/regions": {
      "get": {
        "operationId": "listRegions",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BodyRegion"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/regions/{id}": {
      "get": {
        "operationId": "getRegion",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BodyRegion"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/regions/{id}/topics": {
      "get": {
        "operationId": "regionTopics",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Topic"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/topics": {
      "get": {
        "operationId": "searchTopics",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicPage"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "regionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/topics/{id}": {
      "get": {
        "operationId": "getTopic",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Topic"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/sources": {
      "get": {
        "operationId": "listSources",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HealthSource"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{id}": {
      "get": {
        "operationId": "getSource",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSource"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/screening-questions": {
      "get": {
        "operationId": "screeningQuestions",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScreeningQuestion"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/guidance": {
      "post": {
        "operationId": "educationalGuidance",
        "description": "No AI or free-text medical interpretation. Structured screening takes priority over educational content.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuidanceInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuidanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until retry"
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BodyRegion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "midline"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "side"
        ]
      },
      "Topic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "regionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "symptoms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commonness": {
            "type": "string"
          },
          "generalCare": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "whenToSeekHelp": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contentStatus": {
            "type": "string",
            "enum": [
              "editorial_draft",
              "clinically_reviewed"
            ]
          }
        },
        "required": [
          "id",
          "regionIds",
          "title",
          "overview",
          "symptoms",
          "commonness",
          "generalCare",
          "whenToSeekHelp",
          "sourceIds",
          "contentStatus"
        ]
      },
      "HealthSource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessedOn": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "accessedOn"
        ]
      },
      "TopicPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Topic"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "SafetyScreening": {
        "type": "object",
        "properties": {
          "chestPain": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          },
          "seriousAccident": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          },
          "backNeurologicalSymptoms": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          },
          "lossOfSensation": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          },
          "unableToUseLimb": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          },
          "feverWithHotSwollenJoint": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          },
          "deformity": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          },
          "suddenSeverePain": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          }
        },
        "required": [
          "chestPain",
          "seriousAccident",
          "backNeurologicalSymptoms",
          "lossOfSensation",
          "unableToUseLimb",
          "feverWithHotSwollenJoint",
          "deformity",
          "suddenSeverePain"
        ]
      },
      "GuidanceInput": {
        "type": "object",
        "properties": {
          "regionId": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "activity": {
            "type": "string",
            "maxLength": 200
          },
          "onset": {
            "type": "string",
            "maxLength": 200
          },
          "durationDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 36500
          },
          "painIntensity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "screening": {
            "$ref": "#/components/schemas/SafetyScreening"
          }
        },
        "required": [
          "regionId",
          "description"
        ]
      },
      "GuidanceResponse": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "educational"
            ]
          },
          "aiEnabled": {
            "type": "boolean",
            "const": false
          },
          "regionId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "emergency",
              "urgent",
              "needs_more_information",
              "not_assessed"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Topic"
            }
          },
          "generalCare": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "whenToSeekHelp": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "followUpQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mode",
          "aiEnabled",
          "regionId",
          "summary",
          "disposition",
          "reasons",
          "topics",
          "generalCare",
          "whenToSeekHelp",
          "followUpQuestions",
          "sourceIds",
          "limitations"
        ]
      },
      "ScreeningQuestion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "appliesTo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "prompt",
          "appliesTo"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "const": true
          },
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code",
          "reason",
          "requestId"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "topicCount": {
            "type": "integer"
          },
          "sourceCount": {
            "type": "integer"
          },
          "aiEnabled": {
            "type": "boolean",
            "const": false
          },
          "contentStatus": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "topicCount",
          "sourceCount",
          "aiEnabled",
          "contentStatus"
        ]
      }
    }
  }
}
