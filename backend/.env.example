# Relative to the directory where the backend starts. Defaults to content/ or ../content/.
CONTENT_DIRECTORY=../content
# Comma-separated exact origins, without trailing slashes. Empty disables cross-origin browser access.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GUIDANCE_REQUESTS_PER_MINUTE=20
# Tendi AI (Google Gemini). Leave GEMINI_API_KEY empty to use the saved library only.
# Get a key at https://aistudio.google.com/apikey. Never commit a real key: put it in backend/.env (git-ignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_REQUESTS_PER_MINUTE=10

